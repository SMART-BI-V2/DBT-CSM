# Example dbt profile. Copy to ~/.dbt/profiles.yml and fill in credentials.
# The target connection is the SmartBI warehouse database (casumina_prod).
casumina_csm:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('DB_HOST', '127.0.0.1') }}"
      port: "{{ env_var('DB_PORT', 54329) | int }}"
      user: "{{ env_var('DB_USER', 'dbt_user') }}"
      password: "{{ env_var('DB_PASSWORD', '') }}"
      dbname: "{{ env_var('DB_NAME', 'casumina_prod') }}"
      schema: "{{ env_var('DB_SCHEMA', 'csm') }}"
      threads: 4
      sslmode: prefer
